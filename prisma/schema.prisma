// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// ------------------------Generic SCHEMA-------------------------

model Tag {
    name          String          @id
    AdminAssetTag AdminAssetTag[]
}

enum MediaType {
    MUSIC
    VIDEO
    IMAGE
    THREE_D
    DOCUMENT
}

// ------------------------NOTIFICATION SCHEMA-------------------------
enum PinType {
    EVENT
    BOUNTY
    EXPERIENCE
    LAUNCH
    OTHER
    LANDMARK
}

enum NotificationType {
    LIKE
    COMMENT
    SUBSCRIPTION
    POST
    SHOP_ASSET
    FOLLOW
    MEMBER
    REPLY
    BOUNTY
    BOUNTY_PARTICIPANT
    BOUNTY_SUBMISSION
    BOUNTY_COMMENT
    BOUNTY_REPLY
    BOUNTY_WINNER
    BOUNTY_DOUBT
    BOUNTY_DOUBT_CREATE
    BOUNTY_DOUBT_REPLY
}

// it is kinda notification actor and the entity that is being acted upon
// Notification model to track notifications for both users and creators
model Notification {
    id Int @id @default(autoincrement())

    notificationObjectId Int
    notificationObject   NotificationObject @relation(fields: [notificationObjectId], references: [id], onDelete: Cascade)

    seen      DateTime?
    createdAt DateTime  @default(now())

    notifierId String
    isCreator  Boolean @default(false) // Notification for creators if true, for users if false
}

model NotificationObject {
    id             Int              @id @default(autoincrement())
    entityType     NotificationType
    // Int id for entities with numeric PKs (Post, Comment, Follow, ...).
    entityId       Int?
    // String id for entities with non-numeric PKs (Bounty uses a UUID).
    entityStringId String?
    createdAt      DateTime         @default(now())
    Notification   Notification[]
    actorId        String
    actor          User             @relation(fields: [actorId], references: [id], onDelete: Cascade)
    isUser         Boolean          @default(true)
}

// ------------------------FAN SCHEMA-------------------------
model Subscription {
    id            Int             @id @default(autoincrement())
    name          String
    description   String
    features      String[] // Stored as JSON array
    color         String          @default("bg-blue-500")
    popular       Boolean         @default(false)
    isActive      Boolean         @default(true)
    price         Float // here price is the copy of creator page asset
    creatorId     String
    creator       Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    assets        Asset[]
    LocationGroup LocationGroup[]
    postGroup     PostGroup[]

    @@unique([name, creatorId])
}

model Like {
    id          Int       @id @default(autoincrement())
    userId      String
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt   DateTime  @default(now())
    postGroupId Int
    postGroup   PostGroup @relation(fields: [postGroupId], references: [id], onDelete: Cascade)
    status      Boolean   @default(true)

    @@unique([postGroupId, userId])
}

model Comment {
    id              Int       @id @default(autoincrement())
    parentCommentID Int? // Optional field to reference parent comment (for nested comments)
    userId          String // Foreign key referencing User model
    user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    content         String // Content of the comment
    postGroupId     Int
    postGroup       PostGroup @relation(fields: [postGroupId], references: [id], onDelete: Cascade)
    // Optional relationship: a comment can have a parent comment
    parentComment   Comment?  @relation("ChildComments", fields: [parentCommentID], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) // Timestamp when the comment was created

    // Optional field: allows for a comment to have child comments (replies)
    childComments Comment[] @relation("ChildComments") // Collection of child comments (replies)
}

model User_Asset {
    id        Int     @id @default(autoincrement())
    userId    String
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    isRoyalty Boolean @default(false)
    assetId   Int
    asset     Asset   @relation(fields: [assetId], references: [id], onDelete: NoAction)

    buyAt DateTime @default(now())
}

model Follow {
    id     Int    @id @default(autoincrement())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    followAt DateTime @default(now())

    // Unique constraint on userId and subscriptionId
    @@unique([userId, creatorId])
}

// General Follow
model TemporalFollow {
    id     Int    @id @default(autoincrement())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    followAt DateTime @default(now())

    // Unique constraint on userId and subscriptionId
    @@unique([userId, creatorId])
}

model Media {
    id          Int        @id @default(autoincrement())
    url         String
    type        MediaType
    title       String?
    artist      String?
    album       String?
    thumbnail   String?
    duration    Int?
    postGroupId Int?
    postGroup   PostGroup? @relation(fields: [postGroupId], references: [id])
}

model CreatorPageAsset {
    creatorId String @id

    code          String
    issuer        String
    issuerPrivate String?
    thumbnail     String?
    priceUSD      Float   @default(1)
    price         Float   @default(2)

    limit Int

    creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Creator {
    id                   String   @id
    joinedAt             DateTime @default(now())
    profileUrl           String?
    coverUrl             String?
    coverHeightDefault   Int      @default(240)
    coverHeightDesktop   Int      @default(240)
    coverHeightMobile    Int      @default(220)
    sectionLayoutDefault Json?
    sectionLayoutDesktop Json?
    sectionLayoutMobile  Json?
    bio                  String?
    name                 String

    backgroundSVG String?
    showSVG       Boolean @default(false)
    vanityURL     String? @unique(map: "unique_vanityurl")

    storagePub    String
    storageSecret String

    justStorageCreated Boolean?
    aprovalSend        Boolean
    approved           Boolean? // if undefined than it is sended for aproval, false means banned, true means aproved

    // pageAsset
    pageAssetId Int?

    customPageAssetCodeIssuer String? // CODE-ISSUER-ASSET-USD
    //handle
    website                   String?
    twitter                   String?
    instagram                 String?

    user User @relation(fields: [id], references: [id], onDelete: Cascade)

    subscriptions       Subscription[]
    assets              Asset[]
    marketAssets        MarketAsset[]
    pageAsset           CreatorPageAsset?
    followers           Follow[]
    LocationGroup       LocationGroup[]
    Bounty              Bounty[]
    vanitySubscription  VanitySubscription?
    Album               Album[]
    Song                Song[]
    createdAt           DateTime              @default(now())
    Appearance          Appearance[]
    CreatorCustomDomain CreatorCustomDomain[]
    SellPageAsset       SellPageAsset[]
    aiGeneratedContents AiGeneratedContent[]
    temporalFollows     TemporalFollow[]
    creatorAssetIssuer  CreatorAssetIssuer?
    postGroups          PostGroup[]
    hotspots            Hotspot[]
    agentJobs           AgentJob[]
    locationGroupJobs   LocationGroupJob[]
    locationTags        LocationTag[]

    @@index([bio, name])
}

model CreatorAssetIssuer {
    creatorId     String   @unique
    creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    issuer        String
    issuerPrivate String
    createdAt     DateTime @default(now())
}

model Appearance {
    id        String   @id @default(cuid())
    name      String
    isDefault Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    creatorId String? // Optional field to reference the creator
    creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    widgets   Widget[]
    theme     Json? // Store theme as JSON
    isPublic  Boolean  @default(false)

    @@index([creatorId])
}

model Widget {
    id           String  @id @default(cuid())
    widgetId     String // The type of widget (e.g., "stats", "profile", etc.)
    size         String // "small", "medium", or "large"
    order        Int
    pinned       Boolean @default(false)
    groupId      String? // For grouped widgets
    customWidth  Float? // For custom width percentage in groups
    appearanceId String
    settings     Json? // Add this line

    appearance Appearance @relation(fields: [appearanceId], references: [id], onDelete: Cascade)
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt

    @@index([appearanceId])
}

model VanitySubscription {
    id        String   @id @default(cuid())
    creatorId String   @unique
    creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    startDate DateTime @default(now())
    endDate   DateTime

    // Payment tracking
    lastPaymentAmount Float
    lastPaymentDate   DateTime
}

model PostGroup {
    id             Int           @id @default(autoincrement())
    content        String
    heading        String        @default("Heading")
    description    String?
    creatorId      String
    creator        Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    subscriptionId Int?
    subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
    posts       Post[]
    collections PostCollection[]
    likes       Like[]
    comments    Comment[]
    medias      Media[]
}

model Post {
    id          Int             @id @default(autoincrement())
    isCollected Boolean         @default(false)
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    postGroupId Int
    postGroup   PostGroup       @relation(fields: [postGroupId], references: [id], onDelete: Cascade)
    collection  PostCollection?

    @@index([postGroupId])
    @@index([isCollected])
}

model PostCollection {
    id          Int       @id @default(autoincrement())
    postId      Int       @unique
    post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
    userId      String
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    postGroupId Int
    postGroup   PostGroup @relation(fields: [postGroupId], references: [id], onDelete: Cascade)
    collectedAt DateTime  @default(now())

    @@unique([postGroupId, userId])
    @@index([userId])
    @@index([postGroupId])
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? // @db.Text
    access_token      String? // @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? // @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id                String    @id @default(cuid())
    name              String?
    email             String?   @unique
    bio               String?
    image             String?
    emailVerified     DateTime?
    firstSignUpMethod String? // e.g. email, google, github, etc.

    joinedAt         DateTime?          @default(now())
    fromAppSignup    Boolean?           @default(false)
    accounts         Account[]
    sessions         Session[]
    creator          Creator?
    likes            Like[]
    comments         Comment[]
    assets           User_Asset[]
    Admin            Admin[]
    songs            User_Song[]
    followings       Follow[]
    LocationConsumer LocationConsumer[]

    actorNotificationObjects NotificationObject[]
    BountyParticipant        BountyParticipant[]
    BountySubmission         BountySubmission[]
    BountyWinner             BountyWinner[]
    RedeemConsumer           RedeemConsumer[]
    creditBalance            CreditBalance?
    temporalFollows          TemporalFollow[]
    lastFMAccount            LastFMAccount?

    postCollections PostCollection[]

    createdNfts         Nft[]
    nftTokens           NftToken[]
    nftListings         NftListing[]
    nftPurchases        NftPurchase[]
    nftLikes            NftLike[]
    collectionLikes     CollectionLike[]
    nftCollections      Collection[]
    // Personal, invisible-to-everyone-else AR pin sets from a gated NFT's
    // unlock rule — see `LocationGroup.restrictedToUserId`.
    restrictedPinGroups LocationGroup[]  @relation("RestrictedPinGroups")
}

model LastFMAccount {
    id          String  @id @default(cuid())
    username    String
    realName    String?
    country     String?
    sessionKey  String? @unique
    profileUrl  String
    image       String?
    playCount   Int     @default(0)
    userId      String  @unique
    isConnected Boolean @default(false)
    user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// ------------------------MUSIC SCHEMA-------------------------

model Album {
    id          Int      @id @default(autoincrement())
    name        String
    description String
    coverImgUrl String
    creatorId   String?
    creator     Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
    createdAt   DateTime @default(now())
    songs       Song[]
}

model Song {
    id Int @id @default(autoincrement())

    artist String

    assetId Int   @unique
    asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

    creatorId String?
    creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

    price    Float
    priceUSD Float

    albumId Int
    album   Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    User_Song User_Song[]
}

model User_Song {
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    songId Int
    song   Song @relation(fields: [songId], references: [id], onDelete: Cascade)

    @@id([userId, songId])
}

enum ItemPrivacy {
    DRAFT
    FOR_SALE
    NOT_FOR_SALE
    PUBLIC
    FOLLOWER // only for followers
    PRIVATE // only for members
    TIER // tier based
}

// ------------------------Marketplace SCHEMA-------------------------

enum AssetKind {
    STELLAR_CLASSIC
    NON_STELLAR
}

model Asset {
    id          Int     @id @default(autoincrement())
    name        String
    description String?

    limit Int? // if null then it is unlimited

    kind          AssetKind @default(STELLAR_CLASSIC)
    code          String
    issuer        String
    issuerPrivate String?

    mediaType    MediaType
    mediaUrl     String
    thumbnail    String
    demoMediaUrl String?

    fundEndDate DateTime?

    releaseDate DateTime?
    privacy     ItemPrivacy @default(PUBLIC)
    percentage  Float? // this is the percentage of the asset
    creatorId   String? // if null then it is admin asset
    creator     Creator?    @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    tierId        Int?
    tier          Subscription?   @relation(fields: [tierId], references: [id], onDelete: SetNull)
    isQRItem      Boolean         @default(false)
    song          Song?
    buyers        User_Asset[]
    marketItems   MarketAsset[]
    LocationGroup LocationGroup[]
    Redeem        Redeem[]
    createdAt     DateTime        @default(now())
    royaltyReport RoyaltyReport[]
    Stem          Stem[]

    @@unique([code, issuer])
    @@index([name, description])
}

model Stem {
    id          Int     @id @default(autoincrement())
    audioFileId String? // Foreign key to the audio file
    name        String // Name of the stem
    startTime   Float // Start time in seconds
    endTime     Float // End time in seconds
    volume      Float // Volume level (0.0 to 1.0)
    muted       Boolean @default(false) // Whether the stem is muted
    soloed      Boolean @default(false) // Whether the stem is soloed
    trimStart   Float // Optional trim start time in seconds
    trimEnd     Float // Optional trim end time in seconds
    trackIndex  Int // Index of the track in the audio file
    steamUrl    String // URL of the stem audio file
    color       String
    assetId     Int
    asset       Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
}

model RoyaltyReport {
    id        Int      @id @default(autoincrement())
    mediaUrl  String
    mediaName String
    mediaSize Int
    mediaType String
    assetId   Int
    asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// this will eliminate asset buy modal overhead.
enum MarketType {
    SONG
    ADMIN
    FAN
    ROYALTY // for creators
}

// this for creators;
model MarketAsset {
    id       Int         @id @default(autoincrement())
    isQRItem Boolean     @default(false)
    privacy  ItemPrivacy @default(PUBLIC)

    price    Float
    priceUSD Float @default(1)

    type MarketType @default(FAN)

    assetId Int
    asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

    placedAt DateTime @default(now())

    placerId String? // admin placing this assets
    placer   Creator? @relation(fields: [placerId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([assetId, placerId])
}

// ------------------------Wallete SCHEMA-------------------------

model AdminAsset {
    id Int @id @default(autoincrement())

    description String
    link        String
    codeIssuer  String
    code        String

    logoUrl      String
    logoBlueData String?
    color        String

    createdAt   DateTime @default(now())
    // market links
    StellarTerm String?
    StellarX    String?
    Litemint    String?

    adminId String
    admin   Admin  @relation(fields: [adminId], references: [id], onDelete: NoAction)

    tags AdminAssetTag[]
}

model AdminAssetTag {
    id Int @id @default(autoincrement())

    tagName String
    tag     Tag    @relation(fields: [tagName], references: [name], onDelete: Cascade)

    adminAssetId Int
    addminAsset  AdminAsset @relation(fields: [adminAssetId], references: [id], onDelete: Cascade)
}

model Admin {
    id       String   @id
    joinedAt DateTime @default(now())

    profileUrl String?
    coverUrl   String?
    bio        String?
    name       String?

    user       User         @relation(fields: [id], references: [id], onDelete: Cascade)
    AdminAsset AdminAsset[]
}

// ------------------------Mapping SCHEMA-------------------------

model Hotspot {
    id        String  @id @default(cuid())
    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    dropEveryDays    Int
    pinDurationDays  Int
    hotspotStartDate DateTime
    hotspotEndDate   DateTime

    autoCollect Boolean @default(false)
    multiPin    Boolean @default(false)

    shape   String
    geoJson Json

    qstashScheduleId String?
    isActive         Boolean  @default(true)
    hidden           Boolean  @default(false)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    locationGroups LocationGroup[]
}

model LocationTag {
    id        String  @id @default(cuid())
    name      String  @unique
    label     String
    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    locationGroups LocationGroupTag[]
}

model LocationGroupTag {
    locationGroupId String
    locationGroup   LocationGroup @relation(fields: [locationGroupId], references: [id], onDelete: Cascade)
    tagId           String
    tag             LocationTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([locationGroupId, tagId])
}

model LocationTagCache {
    title     String   @id
    tags      String[]
    createdAt DateTime @default(now())
}

model LocationGroup {
    id String @id @default(cuid())

    privacy ItemPrivacy @default(PUBLIC)

    subscriptionId Int?
    Subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

    assetId Int?
    asset   Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

    pageAsset Boolean? @default(false)

    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    hidden    Boolean @default(false)
    limit     Int     @default(0)
    remaining Int     @default(0)

    title       String
    description String?

    startDate DateTime
    endDate   DateTime

    approved Boolean?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    latitude  Float
    longitude Float
    radius    Float

    image String?

    link              String?
    aiUrlDescriptions String[] @default([])

    multiPin Boolean @default(false)
    type     PinType @default(OTHER) // EVENT, LANDMARK, BOUNTY, EXPERIENCE, LAUNCH, OTHER

    locations         Location[]
    hotspot           Hotspot?           @relation(fields: [hotspotId], references: [id])
    hotspotId         String?
    locationGroupTags LocationGroupTag[]

    // ── Gated-NFT unlock pin set (see NftLockedMedia.unlockRule) ────────────
    // When set, this group is a private, single-token clone of one specific
    // locked-content item's unlock rule — invisible to every user except
    // `restrictedToUser` (enforced in gameRouter.getPins /
    // pages/api/game/locations and consumePin), not a shared/public
    // campaign. Null for every ordinary LocationGroup that exists today;
    // nothing above this line changes behavior for those.
    restrictedToUserId     String?
    restrictedToUser       User?           @relation("RestrictedPinGroups", fields: [restrictedToUserId], references: [id])
    // One private pin set per (minted token, gated locked-content item)
    // pair — not per edition, not per buyer, not even per token, since a
    // single token can carry several independently-gated reward items,
    // each with its own pin set that unlocks on its own.
    unlockForTokenId       String?
    unlockForToken         NftToken?       @relation(fields: [unlockForTokenId], references: [id], onDelete: Cascade)
    unlockForLockedMediaId String?
    unlockForLockedMedia   NftLockedMedia? @relation(fields: [unlockForLockedMediaId], references: [id], onDelete: Cascade)
    // Denormalized for convenience queries ("how many pin sets exist for
    // this edition") without joining through NftToken; not itself a lookup
    // key.
    unlockForNftId         String?
    unlockForNft           Nft?            @relation(fields: [unlockForNftId], references: [id], onDelete: Cascade)
    // Set once this item's collected pins meet its rule's requirement and
    // the one-time call to the contract's `unlock_item_for` succeeds. Null
    // until then; lets a retry/cron avoid double-submitting.
    onChainUnlockedAt      DateTime?
    onChainUnlockTxHash    String?

    @@unique([unlockForTokenId, unlockForLockedMediaId])
}

model Location {
    id String @id @default(cuid())

    latitude    Float
    longitude   Float
    hidden      Boolean @default(false)
    autoCollect Boolean

    locationGroupId String?
    locationGroup   LocationGroup? @relation(fields: [locationGroupId], references: [id], onDelete: Cascade)

    consumers LocationConsumer[]
}

model LocationConsumer {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    locationId String
    location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
    redeemCode String    @unique
    isRedeemed Boolean   @default(false)
    redeemedAt DateTime?
    claimedAt  DateTime?

    viewedAt DateTime?

    hidden Boolean @default(false)

    createdAt DateTime @default(now())
}

// Used by the live chat feature (src/components/chat/chat.tsx) — not bounty-specific.
enum UserRole {
    USER
    CREATOR
}

// ------------------------- Bounty Feature ------------------------------------
// Prize escrow lives on-chain in the Soroban `bounty_escrow` contract (see
// src/lib/stellar/bounty/escrow.ts); this mirrors actionverse's model shape
// so both apps share the same deployed contract instance/keyspace.

enum BountyStatus {
    RUNNING
    PAUSED
    COMPLETED
}

enum BountySubmissionStatus {
    PENDING
    APPROVED
    REJECTED
}

model Bounty {
    id          String       @id @default(uuid())
    title       String
    summary     String
    description String
    prizeAmount Float
    rewardNote  String?
    maxWinners  Int          @default(1)
    status      BountyStatus @default(RUNNING)
    txHash      String?

    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    instructions String[] // what participants must submit

    prizeAssetCode   String
    prizeAssetIssuer String?

    // Soroban bounty_escrow contract this bounty's prize is held in — every
    // bounty is on-chain escrow now (see src/lib/stellar/bounty/escrow.ts).
    // Stamped in at creation time so a future contract redeploy/upgrade never
    // breaks an already-funded bounty's selection/claim flow.
    escrowContractId String

    // True when the on-chain "creator" address (the one that funded the
    // escrow and authorizes select_winner/cancel_bounty) is the Creator's
    // custodial storage account (Creator.storagePub/storageSecret) rather
    // than the bounty owner's own wallet/session identity.
    fundedFromCreatorStorage Boolean @default(false)

    // When true, participants must submit proof via Action Cam (live capture,
    // server-stamped + cryptographically sealed). Owner can toggle off at any time.
    requiresActionCam Boolean @default(false)

    // Music & Last.fm integration
    enableMusic Boolean            @default(false)
    musicConfig BountyMusicConfig?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    participants BountyParticipant[]
    submissions  BountySubmission[]
    winners      BountyWinner[]

    @@index([creatorId])
    @@index([status])
    @@index([createdAt])
}

model BountyWinner {
    id       Int    @id @default(autoincrement())
    bountyId String
    bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
    userId   String
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    prizeAmount Float
    txHash      String?
    claimedAt   DateTime?
    selectedAt  DateTime  @default(now())

    @@unique([bountyId, userId])
    @@index([bountyId])
    @@index([userId])
}

model BountyParticipant {
    id       Int    @id @default(autoincrement())
    bountyId String
    bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
    userId   String
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    joinedAt DateTime @default(now())

    trackProgress BountyParticipantTrackProgress[]

    @@unique([bountyId, userId])
    @@index([bountyId])
    @@index([userId])
}

enum BountyMusicMode {
    MUSIC_ONLY
    HYBRID
}

enum BountyRuleType {
    ALL
    ANY_N
    TOTAL_PLAYS
}

model BountyMusicConfig {
    id       String @id @default(uuid())
    bountyId String @unique
    bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)

    musicMode            BountyMusicMode @default(HYBRID)
    ruleType             BountyRuleType  @default(ANY_N)
    customRequiredTracks Int?
    customTotalPlays     Int?

    tracks BountyTrack[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model BountyTrack {
    id            String            @id @default(uuid())
    musicConfigId String
    musicConfig   BountyMusicConfig @relation(fields: [musicConfigId], references: [id], onDelete: Cascade)

    title           String
    artist          String
    album           String?
    albumArtUrl     String?
    durationSec     Int     @default(180)
    targetPlayCount Int     @default(1)

    lastFmUrl  String
    spotifyUrl String?
    youtubeUrl String?

    createdAt DateTime @default(now())

    @@index([musicConfigId])
}

model BountyParticipantTrackProgress {
    id            String            @id @default(uuid())
    participantId Int
    participant   BountyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

    trackId          String
    currentPlayCount Int     @default(0)
    targetPlayCount  Int     @default(1)
    isSatisfied      Boolean @default(false)

    // Play count at the time the participant connected Last.fm / joined —
    // subtracted off live counts to measure plays earned during the bounty.
    // Bandfan-specific: actionverse's own sync instead re-matches scrobbles
    // by timestamp and doesn't need a stored baseline.
    baselinePlayCount Int @default(0)

    updatedAt DateTime @updatedAt

    @@unique([participantId, trackId])
}

model BountySubmission {
    id       Int    @id @default(autoincrement())
    bountyId String
    bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
    userId   String
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    content String
    status  BountySubmissionStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    captures BountySubmissionCapture[]
    media    BountySubmissionMedia[]

    @@index([bountyId])
    @@index([userId])
}

model BountySubmissionMedia {
    id           Int              @id @default(autoincrement())
    submissionId Int
    submission   BountySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

    url      String
    type     MediaType
    fileName String?

    createdAt DateTime @default(now())

    @@index([submissionId])
}

// One submission can contain many captures (photos + videos mixed, or just
// one). Each capture row is one file. Used for both Action Cam (signed) and
// plain (unsigned) flows — the difference is which fields are populated.
model BountySubmissionCapture {
    id           Int              @id @default(autoincrement())
    submissionId Int
    submission   BountySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

    captureType String // "PHOTO" | "VIDEO"

    // ── Integrity hashes ────────────────────────────────────────────
    captureOriginalHash String // sha256 of the raw bytes (client-computed)
    captureSealedHash   String // sha256 of the bytes now in S3

    // ── Action Cam metadata (null for plain uploads) ────────────────
    captureLat        Float?
    captureLon        Float?
    captureCapturedAt DateTime? // server-stamped at seal time
    captureWallet     String?
    captureSignature  String? // HMAC-SHA256 hex, present for Action Cam
    captureSealedAt   DateTime?

    // ── Storage URLs (always full public S3 URLs) ─────────────────
    captureStorageUrl String // URL of the ORIGINAL media in S3
    capturePreviewUrl String? // URL of the stamped preview (Action Cam only); null for plain uploads

    // ── Per-capture status (independent review) ───────────────────
    status BountySubmissionStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([submissionId])
    @@index([status])
}

model Redeem {
    code            String           @id
    totalRedeemable Int
