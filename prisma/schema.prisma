// ------------------------NFT MARKETPLACE SCHEMA-------------------------
// SEP-50 compliant NFT marketplace

enum NftStatus {
    // Registered as an edition entry in the database only — no on-chain
    // presence yet. The row is still fully listed and buyable: `buy_edition`
    // registers the edition on-chain (from this row's own data) the moment
    // the *first* copy sells, so there is no "waiting on the creator" phase
    // to gate visibility on.
    PENDING
    // At least one copy has been minted on-chain (`onChainEditionId` is set).
    MINTED
}

// One creator submission ("edition"): bounded artwork with a fixed `supply`,
// minted lazily on-chain as copies sell rather than up front — see
// `buy_edition` in `contracts/nft_oz`. A `supply` of 1 is the classic 1-of-1
// case; nothing else about the model changes for it.
model Nft {
    id               String        @id @default(uuid())
    name             String
    description      String
    thumbnail        String
    contentUrl       String
    mediaType        String
    creatorId        String
    creator          User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    collectionId     String?
    collection       Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
    // The shared collection contract the edition lives in. Recorded per row
    // so an environment/contract change never silently repoints old rows.
    // Null until the edition's first purchase registers it on-chain.
    contractAddress  String?
    onChainEditionId String?
    royaltyBps       Int           @default(0)
    // Total copies this edition will ever mint (>= 1, default 1).
    supply           Int           @default(1)
    // Cached from the contract's `EditionMeta.minted`, refreshed on every
    // confirmed purchase — a display cache, not a source of truth. The
    // contract's own `minted`/`supply` (read via `edition_meta`) is what
    // `buy_edition` actually enforces.
    mintedCount      Int           @default(0)
    txHash           String?
    status           NftStatus     @default(PENDING)
    tokens           NftToken[]
    prices           NftPrice[]
    purchases        NftPurchase[]
    likes            NftLike[]
    createdAt        DateTime      @default(now())
    updatedAt        DateTime      @updatedAt

    // Denormalized from `NftListing` (recomputed on every listing change) so
    // browse/sort/card views don't need a live aggregate query per NFT —
    // same cached-counter pattern as e.g. Post.viewCount. Covers *resale*
    // listings only; the primary "buy a new copy" price comes from `prices`.
    lowestActivePrice  Float?
    activeListingCount Int          @default(0)
    NftListing         NftListing[]

    // ── Optional "VIP ticket" gating: locked reward content, each item
    // optionally gated by its own unlock rule (see NftLockedMedia.unlockRule)
    // — an item with no rule reveals the moment a copy is bought, an item
    // with one reveals once that copy completes it. Empty `lockedMedia`
    // means an ordinary, ungated edition. ──────────────────────────────────
    lockedMedia     NftLockedMedia[]
    unlockPinGroups LocationGroup[]

    @@index([creatorId])
    @@index([collectionId])
    @@index([status])
}

// One reward item a creator attaches to a gated edition — a song, image,
// video, or a plain external link (e.g. a SoundCloud page rather than a
// file we host). Several can be attached, each optionally gated by its
// own `unlockRule`: an item with no rule reveals the moment a copy is
// bought; an item with one reveals independently once that specific
// copy's own points are all collected.
enum NftLockedMediaType {
    SONG
    IMAGE
    VIDEO
    OTHER
}

model NftLockedMedia {
    id         String             @id @default(uuid())
    nftId      String
    nft        Nft                @relation(fields: [nftId], references: [id], onDelete: Cascade)
    url        String
    type       NftLockedMediaType
    label      String?
    // Display order only — purely a UI hint, safe to change later (e.g. if
    // reordering is ever added). Contrast with `chainIndex` below.
    sortOrder  Int                @default(0)
    // This item's permanent identity for the on-chain `Unlocked(token_id,
    // media_index)` key (see contracts/nft_oz's `unlock_item_for`) —
    // assigned once at creation from the same index as the initial
    // `sortOrder`, then **never reassigned**, even if display order changes
    // later. Existing on-chain unlock records are keyed by this value, so
    // reusing it for a different item would misattribute those records.
    chainIndex Int
    createdAt  DateTime           @default(now())

    unlockRule      NftUnlockLocationRule?
    unlockPinGroups LocationGroup[]

    @@index([nftId])
}

// Only one rule kind exists today — visiting N creator-chosen locations.
// A future rule kind (e.g. "hold X token") gets its own table the same way,
// selected by a new value here, rather than a generic polymorphic rule
// engine built ahead of a second kind actually existing. This is currently
// unused as a discriminator (every `NftUnlockLocationRule` row already
// implies LOCATION_VISIT by construction) — kept for a future second kind.
enum NftUnlockRuleType {
    LOCATION_VISIT
}

// One locked-content item's unlock rule — set once per item, not once per
// edition (see NftLockedMedia's doc comment: each item is gated
// independently, or not at all). Every individually minted copy that owns
// this item gets its own private clone of these points as a
// `LocationGroup` (see `LocationGroup.unlockForLockedMediaId`) — this
// table itself never gets pins collected against it directly.
model NftUnlockLocationRule {
    id            String                   @id @default(uuid())
    lockedMediaId String                   @unique
    lockedMedia   NftLockedMedia           @relation(fields: [lockedMediaId], references: [id], onDelete: Cascade)
    radius        Float                    @default(50) // meters — how close counts as "visiting" a point
    points        NftUnlockLocationPoint[]
    createdAt     DateTime                 @default(now())
}

model NftUnlockLocationPoint {
    id        String                @id @default(uuid())
    ruleId    String
    rule      NftUnlockLocationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
    label     String?
    latitude  Float
    longitude Float
    sortOrder Int                   @default(0)
}

// The price grid a creator sets at creation — one row per currency, always
// both "asset" (mirroring the contract's per-edition `EditionPrices` — the
// only value that ever becomes an on-chain `payment_token`) and "usd" (a
// sticker price for the card/Square checkout path, never itself an
// on-chain currency — resolved directly from this row rather than a
// separate nullable field, and required alongside "asset", not optional:
// a creator sets both or the listing can't be created). Pre-mint this is
// the only source of pricing; once `onChainEditionId` is set,
// `edition_prices` on-chain is the ground truth for the "asset" row, and
// this stays the only source for "usd", which the contract has no concept
// of at all.
model NftPrice {
    id           String   @id @default(uuid())
    nftId        String
    nft          Nft      @relation(fields: [nftId], references: [id], onDelete: Cascade)
    // "asset" | "usd" — see `NftDisplayCurrency` in `~/lib/stellar/oz/nft`.
    paymentToken String
    price        Float
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([nftId, paymentToken])
}

// One row per individually minted copy of an edition. This is what makes a
// specific copy independently resellable once several buyers (or one buyer
// buying more than once) hold different token ids from the same edition —
// an existence-only "who has ever held this" index can't support that.
// `ownerId` is authoritative between confirm* calls, same trust model the
// rest of this router already uses for `Nft.status`/`NftListing` — not
// re-verified against chain on every read.
model NftToken {
    id              String          @id @default(uuid())
    nftId           String
    nft             Nft             @relation(fields: [nftId], references: [id], onDelete: Cascade)
    // The on-chain token_id.
    tokenId         String          @unique
    ownerId         String
    owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    listing         NftListing?
    // This copy's own private AR pin sets — one per gated locked-content
    // item on the edition, if any — see `LocationGroup.unlockForTokenId`.
    unlockPinGroups LocationGroup[]
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt

    @@index([nftId])
    @@index([ownerId])
}

// One row per secondary-market listing of a single already-minted copy —
// mirrors the contract's per-token `Listing`. Primary sales (buying a new,
// not-yet-minted copy of an edition) are priced via `NftPrice`, not this
// model; this is resale only, which is why it's keyed on a specific
// `NftToken` rather than the edition as a whole — a seller with several
// copies of the same edition can list each independently.
model NftListing {
    id           String            @id @default(uuid())
    nftId        String
    nft          Nft               @relation(fields: [nftId], references: [id], onDelete: Cascade)
    tokenId      String            @unique
    token        NftToken          @relation(fields: [tokenId], references: [tokenId], onDelete: Cascade)
    sellerId     String
    seller       User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
    // Denormalized cheapest entry from `prices`, for existing single-price
    // sorting/aggregate code (`Nft.lowestActivePrice` etc.) — `prices` is the
    // source of truth for what this listing actually offers. Always the
    // "asset" row's price — "usd" never becomes an on-chain amount, so it's
    // never the cheapest-entry candidate.
    price        Float
    // SEP-41 token the price is denominated in, mirroring the contract's
    // per-listing `payment_token`. Null means the native XLM SAC (a
    // pre-existing listing from before XLM was dropped as an offered
    // currency — never set for a new listing).
    paymentToken String?
    isActive     Boolean           @default(true)
    createdAt    DateTime          @default(now())
    updatedAt    DateTime          @updatedAt
    prices       NftListingPrice[]

    @@index([nftId, isActive])
}

// A reseller's own price grid for one specific listed copy — same shape as
// `NftPrice` (an edition's primary price grid), but scoped to a single
// `NftListing` instead of a whole edition, mirroring the contract's
// per-token `Listing.prices`.
model NftListingPrice {
    id           String     @id @default(uuid())
    listingId    String
    listing      NftListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
    paymentToken String
    price        Float
    createdAt    DateTime   @default(now())

    @@unique([listingId, paymentToken])
}

enum NftPurchaseStatus {
    PENDING
    CONFIRMED
}

// Tracks one attempted bulk purchase of an edition. This row's id *is* the
// on-chain `purchase_ref` `buy_edition` is called with — created before the
// buyer signs anything, mirroring how `Nft.create` pre-creates its row
// before minting used to happen. Confirming reads back exactly what that
// purchase minted via the contract's `purchase_by_ref`, which is the only
// reliable way to learn the assigned token range (see the doc comment on
// `buy_edition` in `contracts/nft_oz/src/lib.rs` for why).
model NftPurchase {
    id           String            @id @default(uuid())
    nftId        String
    nft          Nft               @relation(fields: [nftId], references: [id], onDelete: Cascade)
    buyerId      String
    buyer        User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
    quantity     Int
    paymentToken String
    unitPrice    Float
    status       NftPurchaseStatus @default(PENDING)
    txHash       String?
    firstTokenId String?
    lastTokenId  String?
    createdAt    DateTime          @default(now())

    @@index([nftId])
    @@index([buyerId])
}

// A named grouping of smart-contract NFTs owned by a creator. Optional — an
// NFT can be minted standalone (collectionId null) or attached to one of the
// creator's collections. Distinct from the classic-Stellar `Creator`/`Asset`
// model entirely — this only groups the new on-chain NFTs.
model Collection {
    id          String           @id @default(uuid())
    name        String
    description String?
    coverImage  String?
    creatorId   String
    creator     User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    nfts        Nft[]
    likes       CollectionLike[]
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    @@unique([creatorId, name])
    @@index([creatorId])
}

// Separate from the generic `Like` model (which is hard-coupled to
// PostGroup) since NFT favorites are keyed on a different entity.
model NftLike {
    id        String   @id @default(uuid())
    nftId     String
    nft       Nft      @relation(fields: [nftId], references: [id], onDelete: Cascade)
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([nftId, userId])
    @@index([userId])
}

// Same pattern as `NftLike`, for favoriting a Collection as a whole rather
// than an individual NFT within it.
model CollectionLike {
    id           String     @id @default(uuid())
    collectionId String
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    userId       String
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt    DateTime   @default(now())

    @@unique([collectionId, userId])
    @@index([userId])
}
