{
    "name": "wadzzo-express",
    "version": "1.0.0",
    "description": "Fully self-contained async task server — agent pipeline + pin creation",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc --noEmitOnError false --skipLibCheck",
